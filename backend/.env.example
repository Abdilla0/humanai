SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
DEBUG=True
DATABASE_URL=postgres://user:password@localhost:5432/humanai_db
REDIS_URL=redis://localhost:6379/0

# Get from aihumanize.io dashboard after buying $25/mo plan
AIHUMANIZE_API_KEY=REPLACE_WITH_AIHUMANIZE_KEY
AIHUMANIZE_API_URL=https://aihumanize.io/api/humanize

# Get from console.cloud.google.com
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# Get from stripe.com dashboard
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_STARTER=REPLACE_WITH_PRICE_ID
STRIPE_PRICE_PRO=REPLACE_WITH_PRICE_ID
STRIPE_PRICE_BUSINESS=REPLACE_WITH_PRICE_ID

FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email verification. Leave EMAIL_HOST blank in local dev to print emails in the backend terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HumanAI <noreply@example.com>
